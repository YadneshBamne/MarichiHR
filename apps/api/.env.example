NODE_ENV=development
PORT=4000

# Neon Postgres — replace with your Neon connection string
DATABASE_URL="postgresql://placeholder:placeholder@placeholder.neon.tech/marichihr?sslmode=require"

# Upstash Redis — replace with your Upstash connection string
REDIS_URL="rediss://placeholder"

# JWT Secrets — change these in production
JWT_ACCESS_SECRET="marichihr-access-jwt-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="marichihr-refresh-jwt-secret-minimum-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Google OAuth SSO — fill when setting up SSO
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Resend Email
RESEND_API_KEY=""
EMAIL_FROM="noreply@marichihr.com"

# Cloudinary File Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AES-256-GCM key for bank account numbers (64 hex chars)
BANK_ENCRYPTION_KEY=
