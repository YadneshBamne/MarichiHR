# Copy to apps/api/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Neon Postgres: pooled connection (host contains -pooler) and direct connection (for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Upstash Redis (BullMQ event bus, rate limits, SSO codes)
REDIS_URL="rediss://default:TOKEN@HOST.upstash.io:6379"

# JWT secrets: long random values, different from each other
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend URL (CORS, redirects after Google sign-in)
CLIENT_URL="http://localhost:5173"

# Google sign-in (optional; leave blank to hide the button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Email: EMAIL_TRANSPORT=log (default, prints to the console) | smtp (Mandrill or any SMTP relay) | resend
EMAIL_TRANSPORT="log"
SMTP_HOST="smtp.mandrillapp.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="hello@example.com"
SMTP_FROM_NAME="MarichiHR"
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"
# Notification channels: email and/or whatsapp (WhatsApp needs Meta Cloud API credentials)
NOTIFY_CHANNELS="email"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cloudinary file storage (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AES-256-GCM key for bank account numbers and MFA secrets: 64 hex characters. Back it up; data is unreadable without it.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_ENCRYPTION_KEY=""

# BullMQ key prefix: give each server sharing one Redis its own (e.g. "dev" on your laptop); default "bull"
QUEUE_PREFIX=""

# Background jobs run inside the API unless false (then run `npm run worker --workspace=apps/api`)
JOBS_ENABLED="true"
# Log every SQL query (noisy)
PRISMA_LOG_QUERIES="false"

# Document storage (CVs, ID scans, licences). Private bucket; downloads use short-lived signed URLs.
# STORAGE_PROVIDER=s3 works with any S3-compatible service: Filebase (endpoint below), Cloudflare R2, Backblaze B2, AWS.
# Check it with: npm run storage:check
STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://s3.filebase.io"
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Fallback: STORAGE_PROVIDER="cloudinary" with the CLOUDINARY_* values above

# Switched off for now (code kept): set to true to offer them
GOOGLE_SIGNIN_ENABLED="false"
PUSH_ENABLED="false"
